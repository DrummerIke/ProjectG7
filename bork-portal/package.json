{
  "name": "bork-portal",
  "version": "1.0.0",
  "description": "Internal PWA Portal for BORK",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "docker-compose up --build",
    "dev:local": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "db:migrate": "npm run prisma migrate dev --workspace=server",
    "db:studio": "npm run prisma studio --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
